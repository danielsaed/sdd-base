{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.local": "deny",
      "*/.env": "deny",
      "*/.env.local": "deny"
    },
    "bash": {
      "*": "allow",
      "cat .env*": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push origin main*": "deny",
      "git push origin HEAD:main*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.85",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ],
      "enabled": true
    }
  }
}
