# Secrets: NEVER commit
.env
.env.*
!.env.example

# Feature working folders (scripts/worktree.sh): a copy of the repo on its branch.
.worktrees/
/.port
# Folders of agents launched with `isolation: worktree`: they clean themselves up.
.claude/worktrees/

# Dumps of a Playwright MCP browser (screenshots, console logs, snapshots): one session's,
# not the project's.
.playwright-mcp/

# OpenCode installs its plugin dependency (@opencode-ai/plugin) in .opencode/ on start.
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/.gitignore

# Dependencies / caches
node_modules/
__pycache__/
.DS_Store
